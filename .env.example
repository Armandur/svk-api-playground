# Kopiera till .env och fyll i riktiga nycklar.
# .env är gitignored.

# SVK-portalen (https://api.svenskakyrkan.se/) - täcker KBR, Platser,
# Försam­lingssök/Flax, UnitAPI, Ämnesområden m.fl.
# Test- och prod-nycklar är separata.
APIKEY_TEST=
APIKEY_PROD=

# Azure APIM subscription-key för CalendarAPI på prod-gateway
# (svk-apim-prod.azure-api.net). Skiljer sig från SVK-portalens
# nycklar.
AZURE_KEY_PROD=

# CS_UserSessionId-cookie från admin.svenskakyrkan.se. Används av
# /api/admin/*-proxyn för att skriva mot CMS:ets interna /webapi/api-v2/
# (dvs. PUT/PATCH av platser med skrivbehörighet utöver vad publika
# nyckeln tillåter). Hämtas från Chrome DevTools → Application →
# Cookies → CS_UserSessionId. Timeout 90 minuter inaktivitet -
# behöver re-extraheras vid SSO-omloggning. Se
# docs-from-claude-code-chrome/platser-edit-flow-2026-05-01.md.
CS_SESSION=
