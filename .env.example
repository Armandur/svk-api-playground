# Kopiera till .env och fyll i riktiga nycklar.
# .env är gitignored.

# SVK-portalen (https://api.svenskakyrkan.se/) - täcker KBR, Platser,
# Försam­lingssök/Flax, UnitAPI, Ämnesområden m.fl.
# Test- och prod-nycklar är separata.
APIKEY_TEST=
APIKEY_PROD=

# Azure APIM subscription-key för CalendarAPI på prod-gateway
# (svk-apim-prod.azure-api.net). Skiljer sig från SVK-portalens
# nycklar.
AZURE_KEY_PROD=
